# /etc/systemd/system/vida-backend.service
# Yoqish:  systemctl daemon-reload && systemctl enable --now vida-backend
[Unit]
Description=Vida ERP / Vida Market Django backend (Uvicorn ASGI, 3 worker)
After=network.target mysql.service mysqld.service docker.service

[Service]
User=vida
Group=vida
WorkingDirectory=/srv/vida/app/backend
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"
Environment="PATH=/srv/vida/app/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
# CLIP modelini internetsiz (kesh bo'yicha) yuklash — birinchi marta backfill'da yuklab olinadi.
Environment="HF_HUB_OFFLINE=1"
# .env ni Django (environ) o'zi o'qiydi: /srv/vida/app/backend/.env
ExecStart=/srv/vida/app/backend/venv/bin/uvicorn config.asgi:application \
    --host 127.0.0.1 --port 8180 \
    --workers 3 --proxy-headers --forwarded-allow-ips="127.0.0.1" \
    --timeout-graceful-shutdown 30
Restart=always
RestartSec=3
# 3 worker x ~2 GB (CLIP) — kamida 8 GB RAM tavsiya etiladi.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
