# /srv/vida/app/backend/.env  (git'ga QO'SHILMAYDI)
# Eski serverdan SECRET_KEY, DEVICE_HMAC_SECRET va GOOGLE_*/TELEGRAM_* ni AYNAN ko'chiring:
# SECRET_KEY o'zgarsa barcha foydalanuvchilar tizimdan chiqib ketadi.
DEBUG=False
SECRET_KEY=eski-serverdagi-bilan-bir-xil
DATABASE_URL=mysql://vida:PAROL@127.0.0.1/furniture_platform
STORAGE_MODE=local

ALLOWED_HOSTS=api.vidamarket.uz,api.qrbite.uz,vidamarket.uz,admin.vidamarket.uz,firma.vidamarket.uz,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.vidamarket.uz,https://api.qrbite.uz,https://vidamarket.uz,https://admin.vidamarket.uz,https://firma.vidamarket.uz
CORS_ALLOWED_ORIGINS=https://vidamarket.uz,https://www.vidamarket.uz,https://admin.vidamarket.uz,https://firma.vidamarket.uz,https://qrbite.uz,https://admin.qrbite.uz,https://firma.qrbite.uz

FRONTEND_URL=https://vidamarket.uz
BACKEND_URL=https://api.vidamarket.uz

# Google (Cloud Console'da yangi domen uchun redirect URI qo'shing — MIGRATION.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Telegram bot webhook (yangi manzil — setWebhook qayta chaqiriladi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://api.vidamarket.uz/api/v1/auth/telegram/webhook/
TELEGRAM_WEBHOOK_SECRET=

FIREBASE_CREDENTIALS_PATH=/srv/vida/app/backend/firebase-credentials.json
DEVICE_HMAC_SECRET=eski-serverdagi-bilan-bir-xil

# Bildirishnomalar (WebSocket) ko'p worker'da ishlashi uchun Redis SHART
REDIS_URL=redis://127.0.0.1:6379/0

# Rasmli qidiruv (Qdrant — deploy/qdrant/docker-compose.yml)
QDRANT_URL=http://127.0.0.1:6333

# SMS (Eskiz) — moderatsiya tasdiqlangach ESKIZ_ENABLED=true
ESKIZ_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Sign in with Apple
APPLE_BUNDLE_ID=uz.vida.burchaksoft
